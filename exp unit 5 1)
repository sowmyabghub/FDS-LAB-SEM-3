# Experiment No: 17
# Experiment to Understand Linear Regression

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
import pickle

# Create the dataset
data = {
    'YearsExperience': [
        1.1, 1.3, 1.5, 2.0, 2.2, 2.9, 3.0, 3.2, 3.2, 3.7,
        3.9, 4.0, 4.0, 4.1, 4.5, 4.9, 5.1, 5.3, 5.9, 6.0,
        6.8, 7.1, 7.9, 8.2, 8.7, 9.0, 9.5, 9.6, 10.3, 10.5
    ],
    'Salary': [
        39343, 46205, 37731, 43525, 39891, 56642, 60150, 54445,
        64445, 57189, 63218, 55794, 56957, 57081, 61111, 67938,
        66029, 83088, 81363, 93940, 91738, 98273, 101302, 113812,
        109431, 105582, 116969, 112635, 122391, 121872
    ]
}

df = pd.DataFrame(data)

# Display dataset
print("Salary Dataset:")
print(df)

# Display information
print("\nDataset Information:")
df.info()

# Remove missing values
df.dropna(inplace=True)

# Statistical description
print("\nStatistical Description:")
print(df.describe())

# Separate features and labels
features = df.iloc[:, [0]].values
label = df.iloc[:, [1]].values

# Split dataset into training and testing data
x_train, x_test, y_train, y_test = train_test_split(
    features, label, test_size=0.2, random_state=42
)

# Create and train the model
model = LinearRegression()
model.fit(x_train, y_train)

# Evaluate the model
print("\nTraining Accuracy:", model.score(x_train, y_train))
print("Testing Accuracy:", model.score(x_test, y_test))

# Display coefficient and intercept
print("Coefficient:", model.coef_)
print("Intercept:", model.intercept_)

# Plot the regression line
plt.scatter(features, label, color='blue', label='Actual Salary')
plt.plot(features, model.predict(features), color='red',
         label='Regression Line')
plt.xlabel('Years of Experience')
plt.ylabel('Salary')
plt.title('Linear Regression - Salary Prediction')
plt.legend()
plt.show()

# Save the trained model
with open('SalaryPred.model', 'wb') as file:
    pickle.dump(model, file)

# Load the saved model
with open('SalaryPred.model', 'rb') as file:
    model = pickle.load(file)

# Predict salary
yr_of_exp = float(input("Enter Years of Experience: "))
yr_of_exp_np = np.array([[yr_of_exp]])
salary = model.predict(yr_of_exp_np)

print("Estimated Salary for {} years of experience is {:.2f}".format(
    yr_of_exp, salary[0][0]
))
